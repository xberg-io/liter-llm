{
  "name": "@xberg-io/liter-llm-cli",
  "version": "2.7.6",
  "mcpName": "io.github.xberg-io/liter-llm",
  "description": "CLI proxy for liter-llm — runs the native liter-llm binary shipped in a per-platform package, downloading it from GitHub releases only as a fallback.",
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/liter-llm.git",
    "directory": "cli-proxy/npm"
  },
  "bin": {
    "liter-llm": "bin/liter-llm.js"
  },
  "files": [
    "bin/",
    "install.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@xberg-io/liter-llm-cli-darwin-arm64": "2.7.6",
    "@xberg-io/liter-llm-cli-darwin-x64": "2.7.6",
    "@xberg-io/liter-llm-cli-linux-arm64-gnu": "2.7.6",
    "@xberg-io/liter-llm-cli-linux-x64-gnu": "2.7.6",
    "@xberg-io/liter-llm-cli-win32-arm64": "2.7.6",
    "@xberg-io/liter-llm-cli-win32-x64": "2.7.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0"
}
