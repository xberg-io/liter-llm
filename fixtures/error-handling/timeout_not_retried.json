{
  "id": "timeout_not_retried",
  "description": "A reply that takes longer than the default timeout ends the call with a Timeout error, and the server receives the request once",
  "docs": {
    "topic": "error-handling",
    "stem": "timeout-not-retried",
    "title": "A request that times out is sent once"
  },
  "category": "error-handling",
  "tags": ["error-handling"],
  "call": "chat",
  "input": {
    "model": "gpt-4",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ]
  },
  "mock_response": {
    "status": 200,
    "delay_ms": 65000,
    "body": {
      "id": "chatcmpl-late",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4",
      "choices": [
        {
          "index": 0,
          "finish_reason": "stop",
          "message": {
            "role": "assistant",
            "content": "late"
          }
        }
      ]
    }
  },
  "assertions": [
    {
      "type": "error",
      "value": "Timeout"
    },
    {
      "type": "equals",
      "field": "mock.requests.total",
      "value": 1
    }
  ]
}
