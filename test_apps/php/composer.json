{
  "name": "xberg-io/e2e-php",
  "description": "E2e tests for PHP bindings",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.1",
    "guzzlehttp/guzzle": "^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Liter\\Llm\\": "../../crates/liter-llm-php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liter\\Llm\\E2e\\": "tests/"
    }
  },
  "scripts": {
    "test": "php run_tests.php"
  }
}
