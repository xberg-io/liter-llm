export VERSION='2.7.1'
export TAP='xberg-io/homebrew-tap'
export CLI_FORMULA='liter-llm'

setup_file() {
  brew trust "$TAP" || true
  brew bundle install --file="$BATS_TEST_DIRNAME/Brewfile"
}

setup() {
  export SCRIPT_DIR="$BATS_TEST_DIRNAME"
  bats_load_library xberg-bats
}

@test 'version' {
  run bash -euo pipefail -c '$CLI_FORMULA --version | grep -Fxq "$CLI_FORMULA $VERSION" && printf "%s" "version-match"'
  xberg_assert_status 0
  xberg_assert_output_contains 'version-match'
}

@test 'help' {
  run bash -euo pipefail -c '$CLI_FORMULA --help'
  xberg_assert_status 0
  xberg_assert_output_contains 'Usage'
}
